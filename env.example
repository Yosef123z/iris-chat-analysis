# IRIS AI Contract API environment

# Required for real KB vector indexing, real customer chat, real chat-batch analysis,
# and LLM-backed owner analytics. Automated tests inject fake LLM/embeddings providers
# and do not call OpenAI.
OPENAI_API_KEY=

# Optional models
GPT_CHAT_MODEL=gpt-4o-mini
INTENT_MODEL=gpt-4o-mini
ANALYSIS_MODEL=gpt-4o-mini

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
CORS_ALLOWED_ORIGINS=

# Optional backend-to-AI shared secret.
AI_BACKEND_API_KEY=

# Auxiliary owner analytics local markdown reports.
OWNER_ANALYTICS_REPORT_DIR=app/data/uploads

# Temporary in-memory session/cart expiry.
SESSION_TTL_HOURS=2
